<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>GoMerchPro — GoPay Merchant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
<style>
:root {
  --bg: #0a0e14;
  --glass: rgba(255,255,255,0.06);
  --glass-border: rgba(255,255,255,0.12);
  --glass-border2: rgba(255,255,255,0.18);
  --text: #f0f4f8;
  --muted: #8b9aab;
  --green: #00d68f;
  --green2: #00b377;
  --green-glow: rgba(0,214,143,0.25);
  --purple: #7c6bff;
  --blue: #6b8aff;
  --red: #ff5c6c;
  --orange: #ff9f43;
  --radius: 20px;
  --radius-sm: 12px;
  --shadow: 0 8px 40px rgba(0,0,0,0.4);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg); color: var(--text);
  min-height: 100vh; min-height: 100dvh;
  overflow-x: hidden; -webkit-font-smoothing: antialiased;
}
body::before {
  content: ''; position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 20% -10%, rgba(0,214,143,0.12), transparent 50%),
    radial-gradient(ellipse 60% 40% at 90% 10%, rgba(107,138,255,0.08), transparent 45%);
  pointer-events: none; z-index: 0;
}
body::after {
  content: ''; position: fixed; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to bottom, #000 0%, transparent 80%);
  pointer-events: none; z-index: 0;
}
.glass {
  background: var(--glass);
  backdrop-filter: blur(12px) saturate(1.2);
  -webkit-backdrop-filter: blur(12px) saturate(1.2);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.glass-strong {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  border: 1px solid var(--glass-border2);
}
html.reduced .glass, html.reduced .glass-strong, html.reduced .header,
html.reduced .console-fab, html.reduced .docs-header {
  backdrop-filter: none !important; -webkit-backdrop-filter: none !important;
}
html.reduced .glass { background: rgba(20,26,36,0.92); }
html.reduced .glass-strong { background: rgba(20,26,36,0.96); }
html.reduced .docs-header { background: rgba(20,26,36,0.9); }

.app {
  position: relative; z-index: 1;
  max-width: 480px; margin: 0 auto;
  min-height: 100vh; min-height: 100dvh;
  display: flex; flex-direction: column;
  padding: 0 16px 24px;
  transition: max-width 0.25s ease;
}
.app.docs-mode { max-width: 820px; }
.app.docs-mode .header { display: none; }
.app.docs-mode .console-fab { display: none !important; }

.header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 0 12px;
  position: sticky; top: 0; z-index: 30;
  background: rgba(10,14,20,0.7);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  margin: 0 -16px; padding-left: 16px; padding-right: 16px;
}
.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; letter-spacing: -0.02em; }
.brand-logo {
  width: 36px; height: 36px; border-radius: 10px;
  background: linear-gradient(145deg, #0d2a1f, #0a1a14);
  border: 1px solid rgba(0,214,143,0.35);
  display: grid; place-items: center;
  box-shadow: 0 0 20px var(--green-glow);
}
.brand-logo svg { width: 18px; height: 18px; }
.brand span em { color: var(--green); font-style: normal; }

.header-actions { display: flex; align-items: center; gap: 8px; }
.badge-connected {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 700;
  color: #7dffc4;
  background: rgba(0,214,143,0.12);
  border: 1px solid rgba(0,214,143,0.25);
  padding: 6px 12px; border-radius: 999px;
}
.badge-connected .dot {
  width: 7px; height: 7px; background: var(--green); border-radius: 50%;
  box-shadow: 0 0 8px var(--green); animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.icon-btn {
  width: 34px; height: 34px; border-radius: 10px;
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.06);
  color: var(--muted);
  display: grid; place-items: center;
  cursor: pointer; transition: 0.2s;
  padding: 0; font-family: inherit;
}
.icon-btn:hover { color: var(--green); border-color: rgba(0,214,143,0.4); }
.icon-btn.spinning svg { animation: spin 0.8s linear infinite; }

.screen { display: none; flex: 1; flex-direction: column; animation: fadeIn 0.35s ease; }
.screen.active { display: flex; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

.auth-wrap { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 20px 0 40px; }
.auth-card { padding: 32px 24px 28px; text-align: center; }
.auth-icon {
  width: 56px; height: 56px; margin: 0 auto 18px;
  border-radius: 16px;
  background: rgba(124,107,255,0.15);
  border: 1px solid rgba(124,107,255,0.3);
  display: grid; place-items: center; color: var(--purple);
}
.auth-card h1 { font-size: 24px; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 6px; }
.auth-card .sub { color: var(--muted); font-size: 13px; margin-bottom: 28px; line-height: 1.5; }
.field-label {
  display: block; text-align: left;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 8px;
}
.phone-row {
  display: flex; align-items: center;
  background: rgba(0,0,0,0.35);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.phone-row:focus-within {
  border-color: rgba(0,214,143,0.5);
  box-shadow: 0 0 0 3px rgba(0,214,143,0.1);
}
.phone-prefix {
  padding: 14px 12px 14px 16px;
  font-size: 15px; font-weight: 600; color: var(--muted);
  border-right: 1px solid var(--glass-border);
  white-space: nowrap;
}
.phone-row input {
  flex: 1; border: 0; outline: 0;
  background: transparent; color: var(--text);
  font-size: 16px; font-weight: 500;
  padding: 14px 16px; font-family: inherit;
}
.phone-row input::placeholder { color: #4a5568; }
.otp-boxes { display: flex; gap: 10px; justify-content: center; margin: 8px 0 20px; }
.otp-boxes input {
  width: 58px; height: 58px; text-align: center;
  font-size: 22px; font-weight: 700;
  border-radius: 14px;
  border: 1px solid var(--glass-border);
  background: rgba(0,0,0,0.35);
  color: var(--text); outline: 0; font-family: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.otp-boxes input:focus {
  border-color: var(--purple);
  box-shadow: 0 0 0 3px rgba(124,107,255,0.2);
}
.otp-hint { font-size: 12px; color: var(--muted); margin-bottom: 20px; }

.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px; width: 100%; padding: 15px 20px;
  border: 0; border-radius: 14px;
  font-size: 15px; font-weight: 700; font-family: inherit;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.2s, opacity 0.2s;
}
.btn:active { transform: scale(0.98); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.btn-primary {
  background: linear-gradient(135deg, var(--green), var(--green2));
  color: #03140e; box-shadow: 0 8px 28px var(--green-glow);
}
.btn-purple {
  background: linear-gradient(135deg, #7c6bff, #5b4cdb);
  color: #fff; box-shadow: 0 8px 28px rgba(124,107,255,0.3);
}
.btn-ghost { background: transparent; color: var(--muted); font-size: 13px; font-weight: 600; margin-top: 14px; padding: 10px; }
.btn-ghost:hover { color: var(--text); }
.btn-sm { width: auto; padding: 10px 16px; font-size: 13px; border-radius: 10px; }
.btn-outline { background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: var(--text); }
.btn-danger-soft { background: rgba(255,92,108,0.1); border: 1px solid rgba(255,92,108,0.25); color: #ff8a96; }
.btn-purple-soft { background: rgba(124,107,255,0.12); border: 1px solid rgba(124,107,255,0.25); color: #b0a6ff; }

.error-msg {
  margin-top: 14px; padding: 10px 14px; border-radius: 10px;
  background: rgba(255,92,108,0.12);
  border: 1px solid rgba(255,92,108,0.3);
  color: #ff8a96; font-size: 12px; font-weight: 500;
  display: none; text-align: left;
}
.error-msg.show { display: block; }
.loading-spinner {
  width: 18px; height: 18px;
  border: 2px solid rgba(0,0,0,0.2);
  border-top-color: #03140e; border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.token-card { padding: 18px; margin-bottom: 16px; }
.token-block { margin-bottom: 14px; }
.token-block:last-of-type { margin-bottom: 12px; }
.token-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
.token-box { background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border); border-radius: 12px; padding: 12px; }
.token-text {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px; line-height: 1.55; color: #a8b8c8;
  word-break: break-all;
  max-height: 52px; overflow: hidden; transition: max-height 0.3s;
}
.token-text.expanded { max-height: 300px; }
.token-actions {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 8px; padding-top: 8px;
  border-top: 1px solid var(--glass-border);
}
.token-toggle {
  font-size: 11px; font-weight: 700; color: var(--muted);
  background: none; border: 0; cursor: pointer; font-family: inherit;
  display: flex; align-items: center; gap: 4px;
}
.token-toggle:hover { color: var(--text); }
.copy-btn {
  width: 32px; height: 32px; border-radius: 8px;
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.05);
  color: var(--muted); cursor: pointer;
  display: grid; place-items: center;
  transition: 0.15s;
}
.copy-btn:hover { color: var(--green); border-color: rgba(0,214,143,0.4); }
.token-status { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #7dffc4; margin-bottom: 14px; }
.token-status .dot { width: 7px; height: 7px; background: var(--green); border-radius: 50%; box-shadow: 0 0 6px var(--green); }
.token-btns { display: flex; gap: 8px; }
.token-btns .btn { flex: 1; }

.menu-tabs { display: flex; gap: 8px; margin-bottom: 16px; }
.menu-tab {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  gap: 6px; padding: 14px 8px; border-radius: 14px;
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.04);
  color: var(--muted); font-size: 11px; font-weight: 700;
  cursor: pointer; font-family: inherit; transition: 0.2s;
}
.menu-tab svg { width: 20px; height: 20px; }
.menu-tab:hover { background: rgba(255,255,255,0.07); color: var(--text); }
.menu-tab.active {
  background: linear-gradient(135deg, rgba(0,214,143,0.2), rgba(0,179,119,0.12));
  border-color: rgba(0,214,143,0.4); color: var(--green);
  box-shadow: 0 4px 20px var(--green-glow);
}
.menu-tab.active[data-tab="history"] {
  background: linear-gradient(135deg, rgba(15,20,30,0.9), rgba(20,28,40,0.9));
  border-color: rgba(255,255,255,0.2); color: var(--text); box-shadow: var(--shadow);
}
.menu-tab.active[data-tab="payouts"] {
  background: rgba(255,255,255,0.08);
  border-color: var(--glass-border2); color: var(--text); box-shadow: none;
}

.panel { display: none; }
.panel.active { display: block; animation: fadeIn 0.3s ease; }
.panel-card { padding: 18px; }
.panel-title {
  font-size: 13px; font-weight: 700; letter-spacing: 0.06em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: 14px;
  display: flex; align-items: center; justify-content: space-between;
}
.panel-title .count {
  font-size: 11px; background: rgba(255,255,255,0.08);
  padding: 3px 10px; border-radius: 999px;
  color: var(--muted); font-weight: 600;
  letter-spacing: 0; text-transform: none;
}
.empty-state { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 13px; }
.empty-state svg { width: 40px; height: 40px; margin-bottom: 12px; opacity: 0.4; }

.qris-form .field { margin-bottom: 14px; }
.qris-form input, .qris-form textarea {
  width: 100%; background: rgba(0,0,0,0.3);
  border: 1px solid var(--glass-border); border-radius: 12px;
  padding: 13px 14px; color: var(--text);
  font-size: 14px; font-family: inherit; outline: 0;
  transition: border-color 0.2s;
}
.qris-form input:focus, .qris-form textarea:focus { border-color: rgba(0,214,143,0.5); }
.qris-form textarea { min-height: 72px; resize: vertical; font-family: ui-monospace, monospace; font-size: 12px; }
.drop-zone {
  border: 1.5px dashed rgba(255,255,255,0.15);
  border-radius: 12px; padding: 28px 16px;
  text-align: center; color: var(--muted); font-size: 12px;
  cursor: pointer; transition: 0.2s; margin-bottom: 14px;
  display: block;
}
.drop-zone:hover, .drop-zone.dragover {
  border-color: rgba(0,214,143,0.4);
  background: rgba(0,214,143,0.05);
  color: var(--green);
}
.drop-zone svg { width: 28px; height: 28px; margin-bottom: 8px; opacity: 0.5; }
.drop-zone.loading { pointer-events: none; opacity: 0.6; }
.qris-result { margin-top: 16px; text-align: center; display: none; }
.qris-result.show { display: block; }
.qris-result img { max-width: 220px; border-radius: 12px; background: #fff; padding: 12px; margin-bottom: 12px; }
.qris-result .amount { font-size: 20px; font-weight: 800; color: var(--green); margin-bottom: 4px; }
.qris-status-badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 999px;
  font-size: 12px; font-weight: 700; margin-top: 8px;
}
.qris-status-badge.pending { background: rgba(255,159,67,0.15); color: var(--orange); border: 1px solid rgba(255,159,67,0.3); }
.qris-status-badge.paid { background: rgba(0,214,143,0.15); color: var(--green); border: 1px solid rgba(0,214,143,0.3); }

.qris-active-card {
  display: none;
  padding: 16px;
  background: linear-gradient(135deg, rgba(0,214,143,0.1), rgba(0,179,119,0.04));
  border: 1px solid rgba(0,214,143,0.3);
  border-radius: 14px;
  margin-bottom: 14px;
}
.qris-active-row { display: flex; align-items: center; gap: 12px; }
.qris-active-icon {
  width: 40px; height: 40px; border-radius: 12px;
  background: rgba(0,214,143,0.2);
  border: 1px solid rgba(0,214,143,0.4);
  display: grid; place-items: center;
  color: var(--green); font-weight: 800; flex-shrink: 0;
}

.data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.data-table th {
  text-align: left; font-size: 10px; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--muted); padding: 0 0 10px;
  border-bottom: 1px solid var(--glass-border);
}
.data-table td { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
.data-table tr:last-child td { border-bottom: 0; }
.status-pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
.status-pill.paid, .status-pill.settlement, .status-pill.success { background: rgba(0,214,143,0.15); color: var(--green); }
.status-pill.pending { background: rgba(255,159,67,0.15); color: var(--orange); }

.profile-header { display: flex; align-items: center; gap: 14px; padding: 20px; margin-bottom: 14px; }
.profile-avatar {
  width: 64px; height: 64px; border-radius: 50%;
  background: linear-gradient(135deg, #0d2a1f, #0a1a14);
  border: 2px solid rgba(0,214,143,0.4);
  display: grid; place-items: center;
  font-size: 24px; font-weight: 800; color: var(--green); flex-shrink: 0;
}
.profile-name { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 3px; word-break: break-word; }
.profile-sub { font-size: 12px; color: var(--muted); word-break: break-word; }
.profile-grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-bottom: 14px; }
.profile-item {
  padding: 14px 16px;
  background: rgba(0,0,0,0.25);
  border: 1px solid var(--glass-border);
  border-radius: 12px; min-width: 0;
}
.profile-item .lbl {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted); margin-bottom: 5px;
}
.profile-item .val { font-size: 14px; font-weight: 600; color: var(--text); word-break: break-word; }

.qris-upload-zone {
  border: 2px dashed rgba(255,255,255,0.2);
  border-radius: 16px; padding: 40px 20px;
  text-align: center; color: var(--muted);
  cursor: pointer; transition: 0.2s;
  background: rgba(0,0,0,0.2);
}
.qris-upload-zone:hover, .qris-upload-zone.dragover {
  border-color: rgba(0,214,143,0.5);
  background: rgba(0,214,143,0.05); color: var(--green);
}
.qris-upload-zone.loading { pointer-events: none; opacity: 0.6; }
.qris-upload-zone svg { width: 44px; height: 44px; opacity: 0.6; }
.qris-upload-preview {
  padding: 16px; background: rgba(0,0,0,0.25);
  border: 1px solid var(--glass-border);
  border-radius: 16px; display: flex; justify-content: center;
  cursor: pointer; transition: 0.2s;
}
.qris-upload-preview:hover { border-color: rgba(0,214,143,0.4); }
.qris-upload-preview.dragover { border-color: var(--green); background: rgba(0,214,143,0.05); }
.qris-upload-preview.loading { pointer-events: none; opacity: 0.5; }
.qris-upload-preview img { width: 220px; height: 220px; background: #fff; padding: 12px; border-radius: 12px; object-fit: contain; }
.qris-upload-actions { display: flex; gap: 8px; margin-top: 12px; }
.qris-upload-actions .btn { flex: 1; }
.qris-string-label {
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted); margin: 18px 0 8px;
}
.qris-string-box {
  font-family: ui-monospace, monospace;
  font-size: 10px; line-height: 1.6; color: #a8b8c8;
  background: rgba(0,0,0,0.35);
  border: 1px solid var(--glass-border);
  border-radius: 10px; padding: 12px;
  word-break: break-all; max-height: 100px; overflow-y: auto;
  cursor: default; user-select: text;
}
.qris-empty { text-align: center; padding: 30px 20px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.storage-badge {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 700;
  padding: 3px 8px; border-radius: 999px;
  letter-spacing: 0.04em;
}
.storage-badge.redis { background: rgba(0,214,143,0.12); color: #7dffc4; border: 1px solid rgba(0,214,143,0.25); }
.storage-badge.local { background: rgba(255,159,67,0.12); color: #ffc78a; border: 1px solid rgba(255,159,67,0.25); }

.apikey-input-row { display: flex; gap: 8px; align-items: stretch; }
.apikey-input-row input {
  flex: 1; background: rgba(0,0,0,0.3);
  border: 1px solid var(--glass-border);
  border-radius: 12px; padding: 13px 14px;
  color: var(--text); font-size: 14px; font-family: inherit; outline: 0;
}
.apikey-input-row input:focus { border-color: rgba(0,214,143,0.5); }
.apikey-box {
  display: flex; align-items: center; gap: 8px;
  background: rgba(0,0,0,0.35);
  border: 1px solid var(--glass-border);
  border-radius: 12px; padding: 12px;
}
.apikey-value {
  flex: 1; font-family: ui-monospace, monospace;
  font-size: 11px; line-height: 1.5;
  color: #a8b8c8; word-break: break-all; min-width: 0;
}
.apikey-actions { display: flex; gap: 6px; flex-shrink: 0; }
.apikey-icon-btn {
  width: 32px; height: 32px; border-radius: 8px;
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.05);
  color: var(--muted); cursor: pointer;
  display: grid; place-items: center;
  transition: 0.15s; padding: 0;
}
.apikey-icon-btn:hover { color: var(--green); border-color: rgba(0,214,143,0.4); }
.apikey-meta {
  font-size: 11px; color: var(--muted);
  margin-top: 8px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
}
.apikey-help {
  font-size: 11px; color: var(--muted);
  line-height: 1.55; margin-top: 10px;
  padding: 10px 12px;
  background: rgba(107,138,255,0.06);
  border: 1px solid rgba(107,138,255,0.2);
  border-radius: 10px;
}
.apikey-help code {
  font-family: ui-monospace, monospace;
  color: #7dffc4; font-size: 10.5px;
  background: rgba(0,0,0,0.35);
  padding: 1px 5px; border-radius: 4px;
}
.apikey-warn {
  font-size: 11px; color: #ffc78a;
  padding: 8px 10px; margin-top: 8px;
  background: rgba(255,159,67,0.08);
  border: 1px solid rgba(255,159,67,0.25);
  border-radius: 8px; line-height: 1.5;
}

.console-fab {
  position: fixed; bottom: 20px; right: 16px; z-index: 40;
  display: flex; align-items: center; gap: 6px;
  padding: 10px 16px; border-radius: 999px;
  background: rgba(15,20,30,0.9);
  border: 1px solid var(--glass-border2);
  color: var(--text); font-size: 12px; font-weight: 700;
  cursor: pointer; font-family: inherit;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  transition: 0.2s;
}
.console-fab:hover { border-color: var(--green); color: var(--green); }
.console-drawer {
  position: fixed; bottom: 0; left: 0; right: 0;
  max-width: 480px; margin: 0 auto; z-index: 50;
  max-height: 55vh; display: none; flex-direction: column;
  border-radius: 20px 20px 0 0; overflow: hidden;
}
.console-drawer.open { display: flex; }
.console-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--glass-border);
  background: rgba(10,14,20,0.95);
  gap: 10px;
}
.console-head h3 {
  font-size: 12px; font-weight: 800;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--green); flex: 1;
}
.console-head-actions { display: flex; gap: 6px; }
.console-head-actions .btn {
  margin: 0; padding: 6px 12px;
  font-size: 11px; font-weight: 700; border-radius: 8px;
  width: auto; border: 1px solid;
}
.console-body {
  flex: 1; overflow-y: auto; padding: 8px 0;
  background: rgba(8,11,16,0.98);
  font-family: ui-monospace, Menlo, monospace; font-size: 11px;
}
.console-item {
  padding: 10px 18px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  display: flex; align-items: flex-start; gap: 10px;
}
.console-item .time { color: var(--muted); white-space: nowrap; }
.console-item .method { color: var(--green); font-weight: 600; }
.console-item .status-code { margin-left: auto; font-weight: 700; color: var(--green); }
.console-item .status-code.err { color: var(--red); }
.console-item .copy-json {
  font-size: 10px; color: var(--muted);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--glass-border);
  border-radius: 4px; padding: 2px 6px;
  cursor: pointer; margin-top: 4px; display: inline-block;
}
.console-empty { text-align: center; padding: 30px; color: var(--muted); font-size: 12px; }

.toast {
  position: fixed; bottom: 80px; left: 50%;
  transform: translateX(-50%) translateY(20px);
  z-index: 60;
  background: #e8fff5; color: #03140e;
  padding: 12px 20px; border-radius: 12px;
  font-size: 13px; font-weight: 700;
  box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  opacity: 0; pointer-events: none;
  transition: 0.25s;
  white-space: nowrap; max-width: 90vw;
  overflow: hidden; text-overflow: ellipsis;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ============ DOCS (REDESIGN) ============ */
.docs-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding: 12px 16px;
  background: rgba(15,20,30,0.6);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  margin-top: 16px; margin-bottom: 20px;
  position: sticky; top: 8px; z-index: 20;
}
.docs-header .brand { font-size: 15px; }
.docs-header .brand-logo { width: 32px; height: 32px; }
.docs-header .brand-logo svg { width: 16px; height: 16px; }

/* HERO */
.docs-hero {
  position: relative;
  padding: 28px 24px;
  border-radius: 20px;
  background:
    linear-gradient(135deg, rgba(0,214,143,0.08), rgba(124,107,255,0.05)),
    rgba(255,255,255,0.03);
  border: 1px solid var(--glass-border);
  overflow: hidden;
  margin-bottom: 24px;
}
.docs-hero::before {
  content: '';
  position: absolute;
  top: -50%; right: -20%;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(0,214,143,0.15), transparent 65%);
  pointer-events: none;
}
.docs-hero-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px;
  background: rgba(0,214,143,0.15);
  border: 1px solid rgba(0,214,143,0.3);
  color: #7dffc4;
  margin-bottom: 14px;
  position: relative;
}
.docs-hero-badge .pulse-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 8px var(--green);
  animation: pulse 2s infinite;
}
.docs-hero h1 {
  font-size: 32px; font-weight: 800;
  letter-spacing: -0.035em; line-height: 1.15;
  margin-bottom: 10px;
  background: linear-gradient(135deg, #fff 20%, #7dffc4 100%);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  position: relative;
}
.docs-hero p {
  color: var(--muted); font-size: 14px;
  line-height: 1.6; max-width: 560px;
  position: relative;
}
.docs-hero p strong { color: var(--text); font-weight: 700; }
.docs-hero p code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px;
  color: #7dffc4;
  background: rgba(0,214,143,0.1);
  padding: 1px 6px; border-radius: 5px;
  border: 1px solid rgba(0,214,143,0.2);
}

.docs-base-url {
  display: flex; align-items: center; gap: 10px;
  margin-top: 16px; padding: 10px 14px;
  border-radius: 12px;
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(0,214,143,0.25);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12.5px; color: #7dffc4;
  position: relative;
  flex-wrap: wrap;
}
.docs-base-url .lbl {
  font-size: 9px; font-weight: 800;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted); flex-shrink: 0;
}
.docs-base-url .url {
  flex: 1; min-width: 0;
  word-break: break-all; color: #7dffc4;
}
.docs-base-url .copy-url {
  width: 28px; height: 28px;
  border-radius: 8px; flex-shrink: 0;
  border: 1px solid rgba(0,214,143,0.3);
  background: rgba(0,214,143,0.1);
  color: #7dffc4; cursor: pointer;
  display: grid; place-items: center;
  transition: 0.15s;
}
.docs-base-url .copy-url:hover { background: rgba(0,214,143,0.2); }

/* QUICK NAV */
.docs-nav {
  display: flex; gap: 8px;
  margin-bottom: 24px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: none;
}
.docs-nav::-webkit-scrollbar { display: none; }
.docs-nav-pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; border-radius: 999px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--glass-border);
  color: var(--muted);
  font-size: 12px; font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: 0.2s;
  cursor: pointer;
}
.docs-nav-pill:hover {
  color: var(--green);
  border-color: rgba(0,214,143,0.4);
  background: rgba(0,214,143,0.08);
}
.docs-nav-pill .num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; opacity: 0.7;
}

/* AUTH CARDS */
.docs-auth-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-bottom: 16px;
}
.docs-auth-card {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px;
  background: rgba(0,0,0,0.25);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
}
.docs-auth-num {
  width: 28px; height: 28px; border-radius: 8px;
  background: rgba(0,214,143,0.15);
  border: 1px solid rgba(0,214,143,0.3);
  color: var(--green);
  display: grid; place-items: center;
  font-size: 12px; font-weight: 800;
  flex-shrink: 0;
}
.docs-auth-card .name {
  font-size: 12px; font-weight: 700;
  margin-bottom: 3px;
}
.docs-auth-card code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px; color: #7dffc4;
  background: rgba(0,0,0,0.4);
  padding: 2px 6px; border-radius: 5px;
  word-break: break-all;
}

/* SECTIONS */
.docs-section { margin-bottom: 28px; scroll-margin-top: 80px; }
.docs-section-title {
  display: flex; align-items: center; gap: 10px;
  font-size: 12px; font-weight: 800;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--green);
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--glass-border);
}
.docs-section-title::before {
  content: ''; width: 4px; height: 16px;
  border-radius: 2px; background: var(--green);
  box-shadow: 0 0 12px var(--green);
}
.docs-section-title .docs-count {
  margin-left: auto;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--muted);
  background: rgba(255,255,255,0.06);
  padding: 3px 8px; border-radius: 999px;
  text-transform: none;
}

/* ENDPOINT */
.docs-endpoint {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--glass-border);
  border-radius: 14px;
  margin-bottom: 10px;
  overflow: hidden;
  transition: border-color 0.2s, background 0.2s;
}
.docs-endpoint:hover {
  border-color: var(--glass-border2);
  background: rgba(255,255,255,0.05);
}
.docs-endpoint.open {
  border-color: rgba(0,214,143,0.3);
  background: rgba(0,214,143,0.02);
}
.docs-endpoint-head {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 16px;
  cursor: pointer; user-select: none;
}
.docs-method {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; font-weight: 800;
  padding: 4px 9px; border-radius: 6px;
  letter-spacing: 0.06em; flex-shrink: 0;
  background: rgba(0,214,143,0.15);
  color: var(--green);
  border: 1px solid rgba(0,214,143,0.3);
  min-width: 48px;
  text-align: center;
}
.docs-method.post {
  background: rgba(107,138,255,0.15);
  color: var(--blue);
  border-color: rgba(107,138,255,0.3);
}
.docs-method.del {
  background: rgba(255,92,108,0.15);
  color: var(--red);
  border-color: rgba(255,92,108,0.3);
}
.docs-path {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px; font-weight: 500;
  color: var(--text);
  flex: 1; word-break: break-all;
}
.docs-chevron {
  color: var(--muted);
  transition: transform 0.25s;
  flex-shrink: 0;
}
.docs-endpoint.open .docs-chevron { transform: rotate(180deg); color: var(--green); }

.docs-endpoint-desc {
  font-size: 12px; color: var(--muted);
  padding: 0 16px 12px 74px;
  margin-top: -6px;
  line-height: 1.55;
}
.docs-endpoint-body {
  display: none;
  padding: 4px 16px 18px;
  border-top: 1px solid var(--glass-border);
  margin-top: 8px;
  font-size: 13px;
}
.docs-endpoint.open .docs-endpoint-body {
  display: block;
  animation: fadeIn 0.25s ease;
}
.docs-params-title {
  display: flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--muted);
  margin: 14px 0 8px;
}
.docs-params-title svg { width: 12px; height: 12px; }
.docs-params { display: flex; flex-direction: column; gap: 6px; }
.docs-param {
  display: flex; gap: 10px;
  padding: 9px 12px;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.04);
  border-radius: 9px; font-size: 12.5px;
  align-items: center; flex-wrap: wrap;
}
.docs-param .name {
  font-family: 'JetBrains Mono', monospace;
  color: #b0a6ff; font-weight: 600;
  flex-shrink: 0; min-width: 110px;
}
.docs-param .type {
  color: var(--orange);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px; flex-shrink: 0;
}
.docs-param .req {
  color: #ff8a96;
  font-size: 9px; font-weight: 800;
  padding: 2px 6px;
  background: rgba(255,92,108,0.15);
  border: 1px solid rgba(255,92,108,0.3);
  border-radius: 4px; flex-shrink: 0;
  letter-spacing: 0.05em;
}
.docs-param .opt {
  color: var(--muted);
  font-size: 9px; font-weight: 700;
  padding: 2px 6px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--glass-border);
  border-radius: 4px; flex-shrink: 0;
  letter-spacing: 0.05em;
}
.docs-param .desc {
  color: var(--muted); flex: 1;
  min-width: 180px; font-size: 12px;
}

/* CODE BLOCK */
.docs-code {
  position: relative;
  background: rgba(0,0,0,0.45);
  border: 1px solid var(--glass-border);
  border-radius: 12px;
  margin-top: 12px;
  overflow: hidden;
}
.docs-code-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 12px;
  background: rgba(0,0,0,0.3);
  border-bottom: 1px solid var(--glass-border);
}
.docs-code-head .dots {
  display: flex; gap: 5px;
}
.docs-code-head .dots span {
  width: 9px; height: 9px; border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.docs-code-head .dots span:first-child { background: rgba(255,92,108,0.6); }
.docs-code-head .dots span:nth-child(2) { background: rgba(255,159,67,0.6); }
.docs-code-head .dots span:nth-child(3) { background: rgba(0,214,143,0.6); }
.docs-code-head .label {
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--muted);
}
.docs-code-head .copy {
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--muted);
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--glass-border);
  border-radius: 6px;
  padding: 4px 10px;
  cursor: pointer;
  font-family: inherit;
  transition: 0.15s;
}
.docs-code-head .copy:hover {
  color: var(--green);
  border-color: rgba(0,214,143,0.4);
  background: rgba(0,214,143,0.1);
}
.docs-code pre {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px; line-height: 1.7;
  color: #a8b8c8;
  white-space: pre;
  padding: 12px 14px;
  overflow-x: auto;
}
.tk-key { color: #6b8aff; }
.tk-str { color: #7dffc4; }
.tk-num { color: #ff9f43; }
.tk-bool { color: #b0a6ff; }
.tk-comment { color: #5a6a7a; font-style: italic; }
.tk-cmd { color: #ffc78a; font-weight: 600; }

/* NOTES */
.docs-note {
  display: flex; gap: 10px;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 12.5px;
  margin-top: 12px;
  line-height: 1.6;
  align-items: flex-start;
}
.docs-note .ic {
  font-size: 14px;
  flex-shrink: 0;
  margin-top: 1px;
}
.docs-note.info {
  background: rgba(107,138,255,0.08);
  border: 1px solid rgba(107,138,255,0.25);
  color: #a5b8ff;
}
.docs-note.warn {
  background: rgba(255,159,67,0.08);
  border: 1px solid rgba(255,159,67,0.25);
  color: #ffc78a;
}
.docs-note.success {
  background: rgba(0,214,143,0.08);
  border: 1px solid rgba(0,214,143,0.25);
  color: #7dffc4;
}
.docs-note strong { color: inherit; font-weight: 700; }
.docs-note code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  background: rgba(0,0,0,0.35);
  padding: 1px 6px;
  border-radius: 5px;
  color: #7dffc4;
}

/* FOOTER */
.docs-footer {
  text-align: center;
  padding: 24px 0 12px;
  margin-top: 32px;
  border-top: 1px solid var(--glass-border);
  font-size: 12px;
  color: var(--muted);
  line-height: 1.7;
}
.docs-footer a {
  color: var(--green);
  text-decoration: none;
  font-weight: 700;
}
.docs-footer a:hover { text-decoration: underline; }
.docs-footer .ver {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--muted);
  opacity: 0.7;
  display: block;
  margin-top: 4px;
}

@media (max-width: 600px) {
  .docs-hero { padding: 22px 18px; }
  .docs-hero h1 { font-size: 26px; }
  .docs-endpoint-desc { padding-left: 16px; }
  .docs-param .name { min-width: 0; }
  .docs-header { flex-direction: column; align-items: stretch; padding: 12px; }
  .docs-header .btn { width: 100%; }
  .qris-upload-preview img { width: 180px; height: 180px; }
}
</style>
</head>
<body>
<div class="app" id="appRoot">
  <header class="header">
    <div class="brand">
      <div class="brand-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="#00d68f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
      </div>
      <span>GoMerch<em>Pro</em></span>
    </div>
    <div id="headerBadge" class="header-actions" style="display:none">
      <button class="icon-btn" id="btnRefresh" onclick="refreshAll()" title="Refresh">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M23 4v6h-6M1 20v-6h6"/>
          <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
        </svg>
      </button>
      <div class="badge-connected"><span class="dot"></span> CONNECTED</div>
    </div>
  </header>

  <section id="screen-login" class="screen active">
    <div class="auth-wrap">
      <div class="glass glass-strong auth-card">
        <h1>Merchant Access</h1>
        <p class="sub">Masuk ke dashboard GoBiz Merchant</p>
        <div>
          <label class="field-label">Nomor HP</label>
          <div class="phone-row">
            <span class="phone-prefix">+62</span>
            <input type="tel" id="phoneInput" placeholder="81234567890" inputmode="numeric" autocomplete="tel">
          </div>
        </div>
        <div style="margin-top:20px">
          <button class="btn btn-primary" id="btnLogin" onclick="requestOtp()">
            Lanjutkan
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
        <div class="error-msg" id="loginError"></div>
      </div>
    </div>
  </section>

  <section id="screen-otp" class="screen">
    <div class="auth-wrap">
      <div class="glass glass-strong auth-card">
        <div class="auth-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <h1>Verifikasi OTP</h1>
        <p class="sub">Kode dikirim ke <strong id="otpPhoneDisplay" style="color:var(--text)">+62</strong></p>
        <div class="otp-boxes" id="otpBoxes">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="0" autocomplete="one-time-code">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="1">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="2">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="3">
        </div>
        <p class="otp-hint">Tempel kode OTP, kolom akan terisi otomatis.</p>
        <button class="btn btn-purple" id="btnVerify" onclick="verifyOtp()">Verifikasi</button>
        <button class="btn btn-ghost" onclick="showScreen('login')">GANTI NOMOR HP</button>
        <div class="error-msg" id="otpError"></div>
      </div>
    </div>
  </section>

  <section id="screen-dashboard" class="screen">
    <div class="glass token-card">
