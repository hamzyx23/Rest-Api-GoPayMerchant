async function generateApiKey() {
  const prefixInput = document.getElementById('apikeyPrefix');
  const prefix = (prefixInput?.value || 'GoPay_').trim();
  if (prefix.length < 2 || prefix.length > 20 || !/^[A-Za-z0-9_.-]+$/.test(prefix)) {
    toast('Prefix tidak valid (2-20 char alfanumerik + _ . -)');
    return;
  }

  const btn = document.getElementById('btnGenApiKey');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="loading-spinner"></span> Generating…'; }

  const res = await apiJson('POST', '/gopay/apikey', {
    phone: state.phone,
    access_token: state.accessToken,
    refresh_token: state.refreshToken,
    prefix
  });

  if (res.ok && res.data.success) {
    state.apiKey = res.data.apikey;
    state.apiKeyPrefix = res.data.prefix;
    state.apiKeyCreatedAt = res.data.created_at;
    state.apiKeyStorage = 'redis';
    state.apiKeyRevealed = false;
    setApiKeyStorageBadge();
    toast('API key dibuat ☁️');
    renderApiKeyFilled();
    return;
  }

  try {
    const bytes = crypto.getRandomValues(new Uint8Array(24));
    const rand = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    const key = prefix + rand;
    const data = {
      key, prefix,
      created_at: new Date().toISOString(),
      access_token: state.accessToken,
      refresh_token: state.refreshToken
    };
    localStorage.setItem(apiKeyStorageKey(), JSON.stringify(data));
    state.apiKey = key;
    state.apiKeyPrefix = prefix;
    state.apiKeyCreatedAt = data.created_at;
    state.apiKeyStorage = 'local';
    state.apiKeyRevealed = false;
    setApiKeyStorageBadge();
    toast('API key dibuat (lokal) 💾');
    renderApiKeyFilled();
  } catch (e) {
    toast('Gagal generate: ' + e.message);
  } finally {
    if (btn) { btn.disabled = false; }
  }
}

async function regenerateApiKey() {
  if (!confirm('Regenerate API key? Key lama akan langsung tidak valid.')) return;
  await apiJson('DELETE', '/gopay/apikey', { phone: state.phone });
