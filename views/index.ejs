  state.apiKeyStorage = 'none';
  setApiKeyStorageBadge();
  toast('API key dihapus');
  renderApiKeyEmpty();
}

(function initOtpBoxes() {
  const boxes = document.querySelectorAll('#otpBoxes input');
  boxes.forEach((box, i) => {
    box.addEventListener('input', e => {
      const v = e.target.value.replace(/\D/g, '');
      e.target.value = v.slice(-1);
      if (v && i < boxes.length - 1) boxes[i + 1].focus();
    });
    box.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
    });
    box.addEventListener('paste', e => {
      e.preventDefault();
      const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 4);
      paste.split('').forEach((ch, j) => { if (boxes[j]) boxes[j].value = ch; });
      if (paste.length) boxes[Math.min(paste.length, boxes.length) - 1].focus();
    });
  });
})();

(function initDrop() {
  const zone = document.getElementById('dropZone');
  if (!zone) return;
  ['dragenter', 'dragover'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add('dragover'); }));
  ['dragleave', 'drop'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove('dragover'); }));
  zone.addEventListener('drop', e => {
    const file = e.dataTransfer?.files?.[0];
    if (file) processQrFile(file);
  });
})();

function docsToggle(el) { el.parentElement.classList.toggle('open'); }
function docsCopy(e) {
  e.stopPropagation();
  const code = e.target.closest('.docs-code');
  const pre = code?.querySelector('pre');
  if (!pre) return;
  navigator.clipboard.writeText(pre.innerText).then(() => {
    const old = e.target.textContent;
    e.target.textContent = 'COPIED ✓';
    e.target.style.color = 'var(--green)';
    setTimeout(() => {
      e.target.textContent = old;
      e.target.style.color = '';
    }, 1400);
  }).catch(() => {});
}

(function initDocs() {
  const el = document.getElementById('docsBaseUrl');
  if (el) el.textContent = location.origin;
  const copyBtn = document.getElementById('btnCopyBaseUrl');
  if (copyBtn) copyBtn.addEventListener('click', () => copyText(location.origin));
  // Buka endpoint pertama di tiap section untuk first impression
  if (window.innerWidth >= 768) {
    document.querySelectorAll('.docs-section .docs-endpoint').forEach((ep, i) => {
      if (i === 0) ep.classList.add('open');
    });
  }
})();

(function restore() {
  try {
    const at = localStorage.getItem('gm_access');
    const rt = localStorage.getItem('gm_refresh');
    const ph = localStorage.getItem('gm_phone');
    if (at) {
      state.accessToken = at;
      state.refreshToken = rt || '';
      state.phone = ph || '';
      renderTokens();
      showScreen('dashboard');
      if (navigator.onLine) {
        api('/gopay/validate', { token: at }).then(res => {
          if (res.status === 401) {
            toast('Session kedaluwarsa, login ulang');
            logout();
          }
        });
      }
    }
  } catch (_) {}
})();

document.getElementById('phoneInput')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') requestOtp();
});
</script>
</body>
</html>